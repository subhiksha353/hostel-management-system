# Firebase Database (Cloud Firestore) Configuration
# Get these from your Firebase Console (Project Settings > General > Your Apps > Web App)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Supabase Configuration (Alternative backend, optional)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# AI Configuration (Optional - The app automatically operates in heuristic fallback mode if not provided)
VITE_AI_PROVIDER=heuristic # Options: heuristic, gemini, openai
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
