# Supabase Configuration
# Replace these with your actual Supabase Project URL and Anon Public Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# AI Configuration (Optional - The app automatically operates in heuristic fallback mode if not provided)
VITE_AI_PROVIDER=heuristic # Options: heuristic, gemini, openai
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
